{
  "name": "wellfound-auto-apply",
  "version": "2.0.0",
  "description": "Automated Wellfound & Naukri job applier using Playwright. Modular wellfound/ + naukri/ + shared/ architecture.",
  "main": "index.js",
  "scripts": {
    "start":           "node index.js all --live",
    "dry":             "node index.js all",
    "wellfound":       "node index.js wellfound --live --no-watch",
    "naukri":          "node index.js naukri --live --no-watch",
    "indeed":          "node index.js indeed --live --no-watch",
    "dry:wellfound":   "node index.js wellfound --no-watch",
    "dry:naukri":      "node index.js naukri --no-watch",
    "dry:indeed":      "node index.js indeed --no-watch",
    "login":           "node index.js all login",
    "login:wellfound": "node index.js wellfound login",
    "login:naukri":    "node index.js naukri login",
    "login:indeed":    "node index.js indeed login",
    "offscreen":       "node index.js all --live --offscreen"
  },
  "nodemonConfig": {
    "watch": [
      "index.js",
      ".env",
      "shared",
      "wellfound",
      "naukri",
      "indeed"
    ],
    "ext": "js,json,env",
    "ignore": [
      ".wellfound-chrome-profile/**",
      ".naukri-chrome-profile/**",
      ".indeed-chrome-profile/**",
      ".*-chrome-profile/**",
      "apply-state-*.json",
      "applications*.csv",
      "qa-bank.json*",
      "*.png",
      "node_modules/**"
    ]
  },
  "keywords": [
    "wellfound",
    "playwright",
    "automation",
    "job-apply"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Satyam-xD/Wellfound-Apply.git"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "playwright": "^1.62.1",
    "playwright-core": "^1.61.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}